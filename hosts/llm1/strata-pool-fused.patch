+// Q8_0 and Q8_K quantize every block on its own (ggml's quantize_row_q8_0, q8k_quant_avx2 / the reference), so a
+// pool task can quantize the hidden rows it wrote (STRATA_POOL_TASK_QUANT, pool.cpp).  Other activations, and a
+// Hadamard-folded down (native_quant_h rotates the whole h first): 0.
+int native_quant_h_block(const NativeFmt& f) {
+    if (f.had_d) return 0;
+    return f.d_act == (int) GGML_TYPE_Q8_0 || f.d_act == (int) GGML_TYPE_Q8_K ? (int) ggml_blck_size((ggml_type) f.d_act) : 0;
+}
+
+void native_quant_h_rows(const NativeFmt& f, const float* h, void* dst, int r0, int r1) {
+    uint8_t* d = (uint8_t*) dst + ggml_row_size((ggml_type) f.d_act, r0);
+    if (q8k_avx2(f.d_act)) { q8k_quant_avx2(h + r0, d, r1 - r0); return; }
+    if (q8k_avx1(f.d_act)) { q8k_quant_avx1(h + r0, d, r1 - r0); return; }
+    traits(f.d_act)->from_float(h + r0, d, r1 - r0);
+}
