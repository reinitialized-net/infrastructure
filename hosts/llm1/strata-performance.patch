+int Verifier::batch_cut(const int* rows, int S) const {
+    // one GPU only: a layer split's stages hand rows on in one group
+    static const bool on = [] { const char* v = std::getenv("STRATA_BATCH_SPLIT"); return v == nullptr || v[0] != '0'; }();
+    if (!on || !split_ || S < 2 || next_ != nullptr || lb_ > 0) return 0;
+    int spans = 1, cut = 0;
+    for (int t = 1; t < S; ++t)
+        if (rows[t] != rows[t - 1]) { ++spans; cut = t; }
+    if (spans == 1) return (S + 1) / 2;   // a slot alone: cut like a solo window
+    return spans == 2 ? cut : 0;
+}
