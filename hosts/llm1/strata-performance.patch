+// the eight (ls - 32) of a super-block as int16, in both lanes: ls[i] = nibble i of scales_l | 2 bits i of scales_h << 4
+inline __m256i iq4xs_scales8(const uint8_t* b) {
+    const __m128i sl = _mm_cvtsi32_si128((int) u32(b + 4));
+    const __m128i m4 = _mm_set1_epi8(0x0f);
+    const __m128i nib = _mm_unpacklo_epi8(_mm_and_si128(sl, m4), _mm_and_si128(_mm_srli_epi16(sl, 4), m4));
+    const __m128i sh = _mm_set1_epi16((short) u16(b + 2));
+    // bits 2i..2i+1 of sh to bits 14..15 of lane i, then down to 0..1
+    const __m128i hb = _mm_srli_epi16(_mm_mullo_epi16(sh, _mm_setr_epi16(1 << 14, 1 << 12, 1 << 10, 1 << 8, 1 << 6, 1 << 4,
+                                                                         1 << 2, 1)), 14);
+    const __m128i ls = _mm_sub_epi16(_mm_or_si128(_mm_cvtepu8_epi16(nib), _mm_slli_epi16(hb, 4)), _mm_set1_epi16(32));
+    return _mm256_broadcastsi128_si256(ls);
+}
+
+// one row's pair j against the permuted activations: the int32 partial sums of its eight lanes
+inline __m256i iq4xs_pair(const uint8_t* blk, int j, __m256i values, __m256i m4, __m256i ylo, __m256i yhi, __m256i sc) {
+    const __m256i bits = _mm256_loadu_si256((const __m256i*) (blk + 8 + 32 * j));
+    const __m256i wl = _mm256_shuffle_epi8(values, _mm256_and_si256(bits, m4));
+    const __m256i wh = _mm256_shuffle_epi8(values, _mm256_and_si256(_mm256_srli_epi16(bits, 4), m4));
+    const __m256i pl = _mm256_maddubs_epi16(_mm256_sign_epi8(wl, wl), _mm256_sign_epi8(ylo, wl));
+    const __m256i ph = _mm256_maddubs_epi16(_mm256_sign_epi8(wh, wh), _mm256_sign_epi8(yhi, wh));
+    const __m256i s = _mm256_shuffle_epi8(sc, _mm256_load_si256((const __m256i*) kIq4xsScaleMask[j]));
+    return _mm256_add_epi32(_mm256_madd_epi16(pl, s), _mm256_madd_epi16(ph, s));
+}
+}  // namespace
+
+void iq4xs256_gu1_rows(const uint8_t* blob, size_t gu_row, size_t up_off, int n, const void* act, float* ff,
+                       int r0, int r1) {
+    const block_q8_K* y = (const block_q8_K*) act;
+    const int nb = n / QK_K;
+    const __m256i values = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i*) kvalues_iq4nl));
+    const __m256i m4 = _mm256_set1_epi8(0x0f);
+    const int pf = prefetch_distance();
+    for (int r = r0; r < r1; ++r) {
+        const uint8_t* gr = blob + (size_t) r * gu_row;
+        const uint8_t* ur = blob + up_off + (size_t) r * gu_row;
+        __m256 accg = _mm256_setzero_ps(), accu = _mm256_setzero_ps();
+        for (int i = 0; i < nb; ++i) {
+            const uint8_t* bg = gr + (size_t) i * 136;
+            const uint8_t* bu = ur + (size_t) i * 136;
+            rows_ahead(bg, pf);
+            rows_ahead(bu, pf);
+            const __m256i scg = iq4xs_scales8(bg), scu = iq4xs_scales8(bu);
+            const int8_t* q8 = y[i].qs;
+            __m256i sg = _mm256_setzero_si256(), su = _mm256_setzero_si256();
+            for (int j = 0; j < 4; ++j) {
+                const __m256i ya = _mm256_loadu_si256((const __m256i*) (q8 + 64 * j));
+                const __m256i yb = _mm256_loadu_si256((const __m256i*) (q8 + 64 * j + 32));
+                const __m256i ylo = _mm256_permute2x128_si256(ya, yb, 0x20);   // values 0-15 of sub-blocks 2j, 2j+1
+                const __m256i yhi = _mm256_permute2x128_si256(ya, yb, 0x31);   // values 16-31
+                sg = _mm256_add_epi32(sg, iq4xs_pair(bg, j, values, m4, ylo, yhi, scg));
+                su = _mm256_add_epi32(su, iq4xs_pair(bu, j, values, m4, ylo, yhi, scu));
+            }
+            accg = _mm256_fmadd_ps(_mm256_set1_ps(h2f(u16(bg)) * y[i].d), _mm256_cvtepi32_ps(sg), accg);
+            accu = _mm256_fmadd_ps(_mm256_set1_ps(h2f(u16(bu)) * y[i].d), _mm256_cvtepi32_ps(su), accu);
+        }
+        const float g = hsum8(accg), u = hsum8(accu);
+        ff[r] = (g / (1.f + std::exp(-g))) * u;
+    }
+}
+
 }  // namespace strata::kernels::cpu
