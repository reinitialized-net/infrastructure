+int Verifier::batch_cut(const int* rows, int S, bool split) {
+    if (!split || S < 2) return 0;
+    int spans = 1, cut = 0;
+    for (int t = 1; t < S; ++t)
+        if (rows[t] != rows[t - 1]) { ++spans; cut = t; }
+    if (spans == 1) return (S + 1) / 2;   // a slot alone: cut like a solo window (its span split, GDN from its start)
+    return spans == 2 ? cut : 0;
+}
