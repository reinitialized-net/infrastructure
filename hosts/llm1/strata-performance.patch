+// ================================ the hc read on the GGUF's 4-bit weights ================================
+//
+// The OrcaRouter IQ4_XS file stores hc_*_down as IQ4_XS and hc_*_up as IQ4_NL (329 MiB); the BF16 copies the pack
+// makes of them (--compat-bf16) are 1,207 MiB of VRAM and 3.7x the bytes every window reads.  These kernels read the
+// 4-bit blocks and dequantize in registers: d * (ls - 32) * kvalue is exact in FP32 (11 + 6 + 7 significant bits), so
+// the weights are the GGUF's exactly (the BF16 copies rounded them).  The norm is the default read's kernel.
+namespace {
+
+__device__ const int8_t kGrIq4Values[16] = {-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113};
+constexpr int XS_BYTES = 136;                     // block_iq4_xs: d, scales_h, scales_l[4], qs[128]
+constexpr int NL_BYTES = 18;                      // block_iq4_nl: d, qs[16]
+constexpr int XS_ROW = D / 256 * XS_BYTES;        // 5440 B: one down row (10240 values)
+constexpr int NL_ROW = LR / 32 * NL_BYTES;        // 180 B: one up row (320 values)
+constexpr int QN_TILE = 512;                      // down: activations staged per tile, 2 superblocks
+constexpr int QN_PAD = QN_TILE / 32 * 48;         // ... in 48-float strides per 32 (bank-conflict-free float4 reads)
+constexpr int QN_ROWS = 2;                        // down rows per warp: each staged activation feeds both
+constexpr int QN_DOWN_BLOCKS = LR / (WARPS * QN_ROWS);   // 20, plus one for the BF16 inject rows
+static_assert(D % QN_TILE == 0 && LR % (WARPS * QN_ROWS) == 0, "native hc read geometry");
+
+__device__ __forceinline__ int qn_pad(int x) { return x + (x >> 5) * 16; }
+
+// lo[k][row] = silu((W_down[row] . xn[k]) / hc), and the BF16 inject rows: the default down kernel's outputs.  Lane l
+// owns bytes 4l..4l+3 of every superblock's qs: sub-block l/4, values (l%4)*4 + {0..3} (low nibbles) and +16 (high).
+template <int MAX_T>
+__global__ void __launch_bounds__(THREADS) gr_down_iq4xs_kernel(GrMulti m) {
+    extern __shared__ __align__(16) float xt[];   // [T][QN_PAD]
+    __shared__ float kv[16];
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    const int T = m.T;
+    if (t < 16) kv[t] = (float) kGrIq4Values[t];
+    const bool inject_block = blockIdx.x == QN_DOWN_BLOCKS;
+    const bool active = !(inject_block && (m.a[0].w_inject == nullptr || warp >= HC));
+    const int row0 = inject_block ? warp : (blockIdx.x * WARPS + warp) * QN_ROWS;
+    const uint8_t* q0 = (const uint8_t*) m.a[0].q_down + (size_t) (inject_block ? 0 : row0) * XS_ROW;
+    const uint16_t* irow = inject_block && active ? m.a[0].w_inject + (size_t) row0 * D : nullptr;
+    const int ib = lane >> 2, j0 = (lane & 3) * 4;
+    float acc[QN_ROWS][MAX_T];
+#pragma unroll
+    for (int r = 0; r < QN_ROWS; ++r)
+#pragma unroll
+        for (int k = 0; k < MAX_T; ++k) acc[r][k] = 0.0f;
+    for (int base = 0; base < D; base += QN_TILE) {
+        __syncthreads();                                   // the previous tile is consumed (and kv is written)
+        for (int i = t; i < T * (QN_TILE / 4); i += THREADS) {
+            const int k = i / (QN_TILE / 4), x = (i - k * (QN_TILE / 4)) * 4;
+            *reinterpret_cast<float4*>(xt + k * QN_PAD + qn_pad(x)) =
+                *reinterpret_cast<const float4*>(m.xn + (size_t) k * D + base + x);
+        }
+        __syncthreads();
+        if (!active) continue;
+        if (!inject_block) {
+#pragma unroll
+            for (int sb = 0; sb < QN_TILE / 256; ++sb) {
+                const int blk = base / 256 + sb;
+                float w[QN_ROWS][8];
+#pragma unroll
+                for (int r = 0; r < QN_ROWS; ++r) {
+                    const uint8_t* b = q0 + (size_t) r * XS_ROW + (size_t) blk * XS_BYTES;
+                    const float d = __half2float(__ushort_as_half(*reinterpret_cast<const unsigned short*>(b)));
+                    const unsigned sh = *reinterpret_cast<const unsigned short*>(b + 2);
+                    const int ls = ((b[4 + (ib >> 1)] >> (4 * (ib & 1))) & 0xf) | (((sh >> (2 * ib)) & 3) << 4);
+                    const float dl = d * (float) (ls - 32);
+                    const uint32_t q = __ldg(reinterpret_cast<const unsigned int*>(b + 8) + lane);
+#pragma unroll
+                    for (int j = 0; j < 4; ++j) {
+                        w[r][j] = dl * kv[(q >> (8 * j)) & 0xf];
+                        w[r][4 + j] = dl * kv[(q >> (8 * j + 4)) & 0xf];
+                    }
+                }
+                const int x0 = qn_pad(sb * 256 + 32 * ib) + j0;
+#pragma unroll
+                for (int k = 0; k < MAX_T; ++k) {
+                    if (k >= T) break;
+                    const float4 lo4 = *reinterpret_cast<const float4*>(xt + k * QN_PAD + x0);
+                    const float4 hi4 = *reinterpret_cast<const float4*>(xt + k * QN_PAD + x0 + 16);
+#pragma unroll
+                    for (int r = 0; r < QN_ROWS; ++r) {
+                        float s = acc[r][k];
+                        s = fmaf(w[r][0], lo4.x, s); s = fmaf(w[r][1], lo4.y, s);
+                        s = fmaf(w[r][2], lo4.z, s); s = fmaf(w[r][3], lo4.w, s);
+                        s = fmaf(w[r][4], hi4.x, s); s = fmaf(w[r][5], hi4.y, s);
+                        s = fmaf(w[r][6], hi4.z, s); s = fmaf(w[r][7], hi4.w, s);
+                        acc[r][k] = s;
+                    }
+                }
+            }
+        } else {
+#pragma unroll
+            for (int q = 0; q < QN_TILE / 8 / 32; ++q) {   // BF16 inject row: 8 values per lane per chunk
+                const int j = lane + 32 * q;
+                const uint4 wv = __ldg(reinterpret_cast<const uint4*>(irow + base) + j);
+                const int x = qn_pad(j * 8);                   // 8 aligned values never straddle a 32-stride
+#pragma unroll
+                for (int k = 0; k < MAX_T; ++k)
+                    if (k < T) acc[0][k] += dot8(wv, xt + k * QN_PAD + x);
+            }
+        }
+    }
+    if (!active) return;
+#pragma unroll
+    for (int r = 0; r < QN_ROWS; ++r) {
+        if (inject_block && r > 0) break;
+#pragma unroll
+        for (int k = 0; k < MAX_T; ++k) {
+            if (k >= T) break;
+            const float s = warp_sum(acc[r][k]);
+            if (lane != k) continue;
+            if (inject_block) {
+                m.a[k].inject_out[row0] = s;
+            } else {
+                const float x = s / (float) HC;
+                m.a[k].lo[row0 + r] = x / (1.0f + __expf(-x));
+            }
+        }
+    }
+}
+
+// mixed[k][d] = mean_c xn[k][c,d] * sigmoid(W_up[c*n_embd + d] . lo[k]), R updated in place when apply: the default
+// up kernel's epilogue.  A block is QU_COLS columns x 4 streams, one thread per row; the block's rows (4 runs of
+// QU_COLS consecutive rows) are staged into shared memory by 16-byte loads first, so the global reads are coalesced
+// although an IQ4_NL row is 180 B.
+constexpr int QU_COLS = 32;
+constexpr int QU_THREADS = QU_COLS * HC;          // 128
+constexpr int QU_BLOCKS = N / QU_COLS;            // 80
+constexpr int QU_LS = LR / 32 * 33;               // lo staged as 10 rows of 32 + 1 pad float
+
+template <int MAX_T>
+__global__ void __launch_bounds__(QU_THREADS) gr_up_iq4nl_kernel(GrMulti m) {
+    __shared__ __align__(16) uint8_t wsm[HC][QU_COLS * NL_ROW];   // 4 x 5760 B
+    __shared__ float lo[MAX_T][QU_LS];
+    __shared__ float kv[16];
+    __shared__ float g[MAX_T][HC][QU_COLS];
+    const int t = threadIdx.x;
+    const int T = m.T;
+    const int c = t / QU_COLS, dd = t - c * QU_COLS;
+    const int d0 = blockIdx.x * QU_COLS;
+    if (t < 16) kv[t] = (float) kGrIq4Values[t];
+    for (int i = t; i < T * LR; i += QU_THREADS) {
+        const int k = i / LR, x = i - k * LR;
+        lo[k][(x >> 5) * 33 + (x & 31)] = m.a[k].lo[x];
+    }
+    // QU_COLS rows of a stream are contiguous: (QU_COLS * 180) / 16 = 360 uint4 per stream
+    for (int i = t; i < HC * (QU_COLS * NL_ROW / 16); i += QU_THREADS) {
+        const int cc = i / (QU_COLS * NL_ROW / 16), o = i - cc * (QU_COLS * NL_ROW / 16);
+        const uint4* src = reinterpret_cast<const uint4*>((const uint8_t*) m.a[0].q_up +
+                                                          ((size_t) cc * N + d0) * NL_ROW);
+        reinterpret_cast<uint4*>(wsm[cc])[o] = __ldg(src + o);
+    }
+    __syncthreads();
+    const uint8_t* row = wsm[c] + dd * NL_ROW;
+    float acc[MAX_T];
+#pragma unroll
+    for (int k = 0; k < MAX_T; ++k) acc[k] = 0.0f;
+#pragma unroll 2
+    for (int b = 0; b < LR / 32; ++b) {
+        const uint8_t* blk = row + b * NL_BYTES;      // 2-byte aligned
+        const unsigned short* h = reinterpret_cast<const unsigned short*>(blk);
+        const float d = __half2float(__ushort_as_half(h[0]));
+        float w[32];
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const unsigned short two = h[1 + j];      // qs[2j], qs[2j+1]
+            w[2 * j] = d * kv[two & 0xf];
+            w[2 * j + 1] = d * kv[(two >> 8) & 0xf];
+            w[2 * j + 16] = d * kv[(two >> 4) & 0xf];
+            w[2 * j + 17] = d * kv[(two >> 12) & 0xf];
+        }
+#pragma unroll
+        for (int k = 0; k < MAX_T; ++k) {
+            if (k >= T) break;
+            const float* l = &lo[k][b * 33];          // broadcast: every thread reads the same lo values
+            float s = acc[k];
+#pragma unroll
+            for (int j = 0; j < 32; ++j) s = fmaf(w[j], l[j], s);
+            acc[k] = s;
+        }
+    }
+    const int i = c * N + d0 + dd;
+#pragma unroll
+    for (int k = 0; k < MAX_T; ++k) {
+        if (k >= T) break;
+        const FusedGrArgs& a = m.a[k];
+        float rv = a.R[i];
+        if (a.apply) {
+            rv = fmaf(a.bo_prev[d0 + dd], 2.0f * sigmoidf_(a.inj_prev[c] / (float) HC), rv);
+            a.R_out[i] = rv;
+        }
+        const float x = rv * a.w_norm[i] * a.rs[c];
+        g[k][c][dd] = x * sigmoidf_(acc[k]);
+    }
+    __syncthreads();
+    for (int j = t; j < T * QU_COLS; j += QU_THREADS) {
+        const int k = j / QU_COLS, col = j - k * QU_COLS;
+        float s = 0.0f;
+#pragma unroll
+        for (int cc = 0; cc < HC; ++cc) s += g[k][cc][col];
+        m.a[k].mixed[d0 + col] = s / (float) HC;
+    }
+}
+
+__global__ void gr_dequant_bf16_kernel(int type, const uint8_t* __restrict__ q, uint16_t* __restrict__ out, int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;   // one output value
+    if (i >= n) return;
+    float v;
+    if (type == kGrNativeDownType) {
+        const int64_t blk = i / 256;
+        const int x = (int) (i - blk * 256), ib = x / 32, p = x % 32;
+        const uint8_t* b = q + blk * XS_BYTES;
+        const float d = __half2float(__ushort_as_half(*reinterpret_cast<const unsigned short*>(b)));
+        const unsigned sh = *reinterpret_cast<const unsigned short*>(b + 2);
+        const int ls = ((b[4 + (ib >> 1)] >> (4 * (ib & 1))) & 0xf) | (((sh >> (2 * ib)) & 3) << 4);
+        const uint8_t byte = b[8 + 16 * ib + (p & 15)];
+        v = d * (float) (ls - 32) * (float) kGrIq4Values[p < 16 ? (byte & 0xf) : (byte >> 4)];
+    } else {
+        const int64_t blk = i / 32;
+        const int p = (int) (i - blk * 32);
+        const uint8_t* b = q + blk * NL_BYTES;
+        const float d = __half2float(__ushort_as_half(*reinterpret_cast<const unsigned short*>(b)));
+        const uint8_t byte = b[2 + (p & 15)];
+        v = d * (float) kGrIq4Values[p < 16 ? (byte & 0xf) : (byte >> 4)];
+    }
+    out[i] = bf16_from_f32(v);
+}
+
+}  // namespace
+
+void gr_dequant_bf16(int type, const void* q, uint16_t* out, int64_t n, void* stream) {
+    if ((type != kGrNativeDownType && type != kGrNativeUpType) || n % 256 != 0) {
+        std::fprintf(stderr, "gr_dequant_bf16: unsupported type %d / size %lld\n", type, (long long) n);
+        std::exit(1);
+    }
+    gr_dequant_bf16_kernel<<<(unsigned) ((n + 255) / 256), 256, 0, (cudaStream_t) stream>>>(type, (const uint8_t*) q,
+                                                                                            out, n);
+}
+
+namespace {
+void launch_native(const GrMulti& m, cudaStream_t st, unsigned long long* stamp_buf, int stamp_i0) {
+    const int T = m.T;
+    gr_norm_split_kernel<<<dim3((unsigned) T, HC), THREADS, 0, st>>>(m);
+    if (stamp_buf) gpu_stamp(stamp_buf, stamp_i0, (void*) st);
+    const size_t smem = (size_t) T * QN_PAD * sizeof(float);   // 24 KB at 8 tokens
+    if (T <= 4) gr_down_iq4xs_kernel<4><<<QN_DOWN_BLOCKS + 1, THREADS, smem, st>>>(m);
+    else gr_down_iq4xs_kernel<kFusedGrMaxT><<<QN_DOWN_BLOCKS + 1, THREADS, smem, st>>>(m);
+    if (stamp_buf) gpu_stamp(stamp_buf, stamp_i0 + 1, (void*) st);
+    if (T <= 4) gr_up_iq4nl_kernel<4><<<QU_BLOCKS, QU_THREADS, 0, st>>>(m);
+    else gr_up_iq4nl_kernel<kFusedGrMaxT><<<QU_BLOCKS, QU_THREADS, 0, st>>>(m);
+}
+}  // namespace
+
+bool fused_gr_read_native(const FusedGrArgs* a, int n_tok, float* xn_scratch, void* stream,
+                          unsigned long long* stamp_buf, int stamp_i0) {
+    if (n_tok < 1 || n_tok > kFusedGrMaxT || xn_scratch == nullptr || a[0].q_down == nullptr || a[0].q_up == nullptr)
+        return false;
+    GrMulti m;
+    for (int t = 0; t < n_tok; ++t) {
+        m.a[t] = a[t];
+        const FusedGrArgs& x = a[t];
+        if (!x.R || !x.w_norm || !x.lo || !x.rs || !x.mixed || (x.w_inject && !x.inject_out) ||
+            (x.apply && (!x.bo_prev || !x.inj_prev || !x.R_out)) || x.q_down != a[0].q_down || x.q_up != a[0].q_up ||
+            x.w_inject != a[0].w_inject || x.w_norm != a[0].w_norm) {
+            std::fprintf(stderr, "fused_gr_read_native: invalid arguments for token %d\n", t);
+            std::exit(1);
+        }
+    }
+    m.xn = xn_scratch;
+    m.T = n_tok;
+    launch_native(m, (cudaStream_t) stream, stamp_buf, stamp_i0);
+    const cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "fused_gr_read_native: %s\n", cudaGetErrorString(e));
+        std::exit(1);
+    }
+    return true;
+}
+
