+bool conversation_state_copy(const SessionState& from, SessionState& to, const ModelGeometry& g,
+                             const std::vector<int32_t>& ids, std::string& error) {
+    ConversationStateSizes za, zb;
+    if (!checkpoint_targets(from, g, ids.size(), za, error) || !checkpoint_targets(to, g, ids.size(), zb, error))
+        return false;
+    if (za.gdn != zb.gdn || owned_qsa(from) != owned_qsa(to) || (from.ple_hist != nullptr) != (to.ple_hist != nullptr))
+        return fail(error, "state copy between sessions carved differently");
+    if (!copy(to.gdn_state, from.gdn_state, za.gdn, error) ||
+        !copy(to.ple_hist, from.ple_hist, from.ple_hist ? za.ple : 0, error)) return false;
+    for (size_t j = 0; j < owned_qsa(from); ++j) {
+        const auto& a = owned(from, j);
+        const auto& b = owned(to, j);
+        if (!copy(b.idx_tail, a.idx_tail, za.tail, error) || !copy(b.idx_dead, a.idx_dead, za.dead, error) ||
+            !copy(b.idx_block_pos, a.idx_block_pos, za.block_pos, error)) return false;
+        if (!ids.empty()) {   // as the restore: the spare row at the prefix's end holds the dead key
+            const size_t row = ids.size() / strata::kernels::qsa_real_shapes().idx_block;
+            if (!copy(b.idx_pooled + row * g.idx_key_dim, b.idx_dead, za.dead, error)) return false;
+        }
+    }
+    const size_t tokens = ids.size();
+    to.ple_prev[0] = tokens >= 2 ? ids[tokens - 2] : -1;
+    to.ple_prev[1] = tokens >= 1 ? ids[tokens - 1] : -1;
+    return sync(error);
+}
