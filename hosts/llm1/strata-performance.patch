+    const __m256i m4 = _mm256_set1_epi8(0x0f);
+    for (int r = r0; r < r1; ++r) {
+        const uint8_t* gr = blob + (size_t) r * gu_row;
+        const uint8_t* ur = blob + up_off + (size_t) r * gu_row;
+        __m256 accg = _mm256_setzero_ps(), accu = _mm256_setzero_ps();
+        for (int i = 0; i < nb; ++i) {
+            const uint8_t* bg = gr + (size_t) i * 136;
+            const uint8_t* bu = ur + (size_t) i * 136;
+            rows_ahead(bg + prefetch_ahead);
+            rows_ahead(bu + prefetch_ahead);
+            const __m256i scg = iq4xs_scales8(bg), scu = iq4xs_scales8(bu);
+            const int8_t* q8 = y[i].qs;
+            __m256i sg = _mm256_setzero_si256(), su = _mm256_setzero_si256();
