+bool conversation_kv_copy(const QsaState& from, const QsaState& to, const ModelGeometry& g, int64_t upto,
+                          bool index, std::string& error) {
+    Layout a{}, b{};
+    if (!layout(from, g, upto, index, a, error) || !valid(from, a, upto, error) ||
+        !layout(to, g, upto, index, b, error) || !valid(to, b, upto, error)) return false;
+    if (a.format != b.format || a.cells != b.cells || a.pooled_rows != b.pooled_rows || a.data != b.data ||
+        a.scales != b.scales || a.pooled != b.pooled || a.value_data != b.value_data || from.kv_mode != to.kv_mode) {
+        error = "conversation snapshot: K/V copy between states of different layouts";
+        return false;
+    }
+    const auto src = pools(from), dst = pools(to);
+    const std::array<size_t,5> sizes = {a.data, a.value_data, a.scales, a.value_scales, a.pooled};
+    for (size_t i = 0; i < sizes.size(); ++i) {
+        if (!sizes[i]) continue;
+        if (!src[i] || !dst[i]) { error = "conversation snapshot: missing state buffer"; return false; }
+        if (!transfer(dst[i], src[i], sizes[i], error)) return false;
+    }
+    // as conversation_kv_restore: the target's VRAM slots still hold its outgoing conversation
+    if (to.kv_mode == 1) strata::kernels::kv_stream_reset(to.map, nullptr);
+    if (to.kv_mode == 2 && upto > 0) {
+        auto shapes = strata::kernels::qsa_real_shapes();
+        shapes.n_head_kv = g.n_head_kv; shapes.head_dim = g.head_dim;
+        const int64_t end = (upto + shapes.page_size - 1) / shapes.page_size;
+        strata::kernels::kv_ring_restore(qsa_attn_pools(to), to.host, qsa_kv_format(to),
+                                        std::max<int64_t>(0, end - to.n_slots), end, to.n_slots, shapes, nullptr);
+    }
+    const auto status = cudaGetLastError();
+    if (status == cudaSuccess) return true;
+    error = std::string("conversation snapshot residency copy: ") + cudaGetErrorString(status);
+    return false;
+}
