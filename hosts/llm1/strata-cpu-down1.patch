+// ---- IQ4_NL down rows for ONE token, in ggml-cpu's arithmetic order (ggml_vec_dot_iq4_nl_q8_0, AVX2 branch): block
+// 2i into one accumulator and 2i+1 into another, each an fmadd of (d_y * d_x) by the block's int32 lane sums, then
+// ggml's hsum_float_8 of their sum.  So the same bits as the engine's one-token path (#152 is untouched), without its
+// per-row call through a function pointer, its two-shuffle decode or its missing prefetch: the activation scales are
+// converted once per call and each row is prefetched one 64-B line at a time (as the lean multi-token rows).
+// An even block count of at most kLeanBlocks1 only (ggml's scalar tail for an odd one is not reproduced here).
+constexpr int kLeanBlocks1 = 64;
+
+bool iq4nl256_down1_fits(int n) { return n % (2 * QK4_NL) == 0 && n / QK4_NL <= kLeanBlocks1; }
+
+void iq4nl256_down1_rows(const uint8_t* w, size_t row_bytes, int n, const void* hq, float* out, int r0, int r1) {
+    const block_q8_0* y = (const block_q8_0*) hq;
+    const int nb = n / QK4_NL;
+    const int pf = prefetch_distance();
+    const __m256i values = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i*) kvalues_iq4nl));
+    const __m256i m4 = _mm256_set1_epi8(15), one = _mm256_set1_epi16(1);
+    float dy[kLeanBlocks1];
+    for (int ib = 0; ib < nb; ++ib) dy[ib] = h2f(y[ib].d);
+    // ggml's mul_add_epi8 + madd(ones): |w| x sign(y, w), the same int32 lane sums
+    auto block = [&](const uint8_t* blk, const block_q8_0& b) {
+        const __m256i bits = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i*) (blk + 2)));
+        const __m256i q4 = _mm256_shuffle_epi8(values, _mm256_and_si256(_mm256_blend_epi32(bits, _mm256_srli_epi16(bits, 4), 0xf0), m4));
+        const __m256i q8 = _mm256_loadu_si256((const __m256i*) b.qs);
+        return _mm256_cvtepi32_ps(_mm256_madd_epi16(_mm256_maddubs_epi16(_mm256_sign_epi8(q4, q4), _mm256_sign_epi8(q8, q4)), one));
+    };
+    for (int r = r0; r < r1; ++r) {
+        const uint8_t* row = w + (size_t) r * row_bytes;
+        if (pf > 0)
+            for (size_t o = 0; o < row_bytes; o += 64) _mm_prefetch((const char*) row + pf + o, _MM_HINT_T0);
+        __m256 acc1 = _mm256_setzero_ps(), acc2 = _mm256_setzero_ps();
+        for (int ib = 0; ib < nb; ib += 2) {
+            const uint8_t* b0 = row + (size_t) ib * sizeof(block_iq4_nl);
+            const uint8_t* b1 = b0 + sizeof(block_iq4_nl);
+            acc1 = _mm256_fmadd_ps(_mm256_set1_ps(dy[ib] * h2f(u16(b0))), block(b0, y[ib]), acc1);
+            acc2 = _mm256_fmadd_ps(_mm256_set1_ps(dy[ib + 1] * h2f(u16(b1))), block(b1, y[ib + 1]), acc2);
+        }
+        const __m256 v = _mm256_add_ps(acc1, acc2);   // ggml's hsum_float_8
+        __m128 s = _mm_add_ps(_mm256_extractf128_ps(v, 1), _mm256_castps256_ps128(v));
+        s = _mm_add_ps(s, _mm_movehl_ps(s, s));
+        s = _mm_add_ss(s, _mm_movehdup_ps(s));
+        out[r] = _mm_cvtss_f32(s);
+    }
+}
