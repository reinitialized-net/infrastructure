diff --git a/src/prefill/dequant_fused_parity.cu b/src/prefill/dequant_fused_parity.cu
new file mode 100644
index 0000000..744acf8
--- /dev/null
+++ b/src/prefill/dequant_fused_parity.cu
@@ -0,0 +1,122 @@
+// Exact fused dequantization versus FP16 dequantization plus widening.
+// Raw and sane blocks, wide and scalar dispatch, whole tensors and row slices.
+#include "strata/kernels/dequant_bf16.hpp"
+
+#include <cuda_runtime.h>
+#include <cuda_fp16.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace K = strata::kernels;
+
+static void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) { std::fprintf(stderr, "dequant_fused_parity: %s: %s\n", what, cudaGetErrorString(e)); std::exit(2); }
+}
+static uint16_t f2h(float f) {   // FP32 -> FP16 bits, round to nearest even (normal range only: the scales below)
+    uint32_t u;
+    std::memcpy(&u, &f, 4);
+    const uint32_t sign = (u >> 16) & 0x8000u;
+    int e = (int) ((u >> 23) & 0xff) - 127 + 15;
+    uint32_t m = u & 0x7fffffu;
+    if (e <= 0) return (uint16_t) sign;
+    if (e >= 31) return (uint16_t) (sign | 0x7c00u);
+    uint32_t h = sign | ((uint32_t) e << 10) | (m >> 13);
+    if ((m & 0x1fffu) > 0x1000u || ((m & 0x1fffu) == 0x1000u && (h & 1u))) ++h;
+    return (uint16_t) h;
+}
+struct Type { int id; const char* name; int block_bytes; };
+static const Type kTypes[] = {{12, "Q4_K", 144}, {13, "Q5_K", 176}, {14, "Q6_K", 210}, {23, "IQ4_XS", 136}};
+
+// `sane`: random codes and scales with a block scale in a weight's range; else raw random bytes
+static std::vector<uint8_t> make_blocks(const Type& t, int64_t rows, int64_t cols, bool sane, uint32_t seed) {
+    std::mt19937 rng(seed);
+    const int64_t nb = rows * (cols / 256);
+    std::vector<uint8_t> b((size_t) nb * t.block_bytes);
+    for (size_t i = 0; i + 4 <= b.size(); i += 4) { const uint32_t r = rng(); std::memcpy(&b[i], &r, 4); }
+    for (size_t i = b.size() & ~(size_t) 3; i < b.size(); ++i) b[i] = (uint8_t) rng();
+    if (sane) {
+        std::uniform_real_distribution<float> ud(1e-4f, 3e-2f);
+        for (int64_t k = 0; k < nb; ++k) {
+            uint8_t* p = b.data() + (size_t) k * t.block_bytes;
+            const uint16_t d = f2h((rng() & 1 ? 1.0f : -1.0f) * ud(rng)), dm = f2h(-ud(rng));
+            if (t.id == 14) std::memcpy(p + 208, &d, 2);
+            else if (t.id == 23) std::memcpy(p, &d, 2);
+            else { std::memcpy(p, &d, 2); std::memcpy(p + 2, &dm, 2); }
+        }
+    }
+    return b;
+}
+
+__global__ void widen(const uint16_t* in, float* out, int64_t n) {
+    int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) out[i] = __half2float(__ushort_as_half(in[i]));
+}
+int main() {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    cudaStream_t s; ck(cudaStreamCreate(&s), "stream");
+    cudaEvent_t start, stop; ck(cudaEventCreate(&start), "event"); ck(cudaEventCreate(&stop), "event");
+    int cases = 0;
+    for (const Type& t : kTypes) {
+        for (int64_t rows : {7, 6144, 10240}) {
+            const int64_t cols = 2560, n = rows * cols;
+            for (bool sane : {false, true}) {
+                auto h = make_blocks(t, rows, cols, sane, 1234 + t.id);
+                uint8_t* blocks; uint16_t* half; float *a, *b;
+                ck(cudaMalloc((void**) &blocks, h.size()), "blocks");
+                ck(cudaMalloc((void**) &half, n * 2), "half");
+                ck(cudaMalloc((void**) &a, n * 4), "a"); ck(cudaMalloc((void**) &b, n * 4), "b");
+                ck(cudaMemcpy(blocks, h.data(), h.size(), cudaMemcpyHostToDevice), "upload");
+                for (int wide : {0, 1}) {
+                    K::dequant_set_wide(wide);
+                    for (int slice : {0, 1}) {
+                        const int64_t row0 = slice ? rows / 3 : 0, nr = rows - row0, count = nr * cols;
+                        auto run = [&](bool fused) {
+                            if (fused) {
+                                if (!K::dequant_f16_f32(t.id, blocks, row0, nr, cols, b, s)) std::exit(2);
+                            } else {
+                                K::dequant_f16(t.id, blocks, row0, nr, cols, half, s);
+                                widen<<<(unsigned)((count + 255) / 256), 256, 0, s>>>(half, a, count);
+                            }
+                        };
+                        ck(cudaMemsetAsync(a, 0xa5, n * 4, s), "guard");
+                        ck(cudaMemsetAsync(b, 0xa5, n * 4, s), "guard");
+                        run(false); run(true);
+                        std::vector<float> ah(n), bh(n);
+                        ck(cudaMemcpyAsync(ah.data(), a, n * 4, cudaMemcpyDeviceToHost, s), "read");
+                        ck(cudaMemcpyAsync(bh.data(), b, n * 4, cudaMemcpyDeviceToHost, s), "read");
+                        ck(cudaStreamSynchronize(s), "sync");
+                        if (std::memcmp(ah.data(), bh.data(), n * 4)) {
+                            std::printf("FAIL type=%d rows=%lld sane=%d wide=%d slice=%d\n", t.id, (long long) rows, sane, wide, slice);
+                            return 1;
+                        }
+                        ++cases;
+                        if (wide && sane && !slice && ((t.id == 13 && rows == 10240) || (t.id == 23 && rows == 6144))) {
+                            for (int pass = 0; pass < 3; ++pass) {
+                                float ms[2];
+                                for (int step = 0; step < 2; ++step) {
+                                    int mode = (step + pass) % 2;
+                                    for (int r = 0; r < 3; ++r) run(mode);
+                                    ck(cudaEventRecord(start, s), "start");
+                                    for (int r = 0; r < 20; ++r) run(mode);
+                                    ck(cudaEventRecord(stop, s), "stop"); ck(cudaEventSynchronize(stop), "wait");
+                                    ck(cudaEventElapsedTime(&ms[mode], start, stop), "time"); ms[mode] /= 20;
+                                }
+                                std::printf("type=%d rows=%lld pass=%d old_ms=%.4f fused_ms=%.4f speedup=%.3f\n",
+                                            t.id, (long long) rows, pass, ms[0], ms[1], ms[0] / ms[1]);
+                            }
+                        }
+                    }
+                }
+                ck(cudaFree(blocks), "free"); ck(cudaFree(half), "free"); ck(cudaFree(a), "free"); ck(cudaFree(b), "free");
+            }
+        }
+    }
+    std::printf("PASS %d bitwise cases, raw and sane blocks, scalar and wide, full and row slices\n", cases);
+    ck(cudaEventDestroy(start), "event"); ck(cudaEventDestroy(stop), "event"); ck(cudaStreamDestroy(s), "stream");
+}
