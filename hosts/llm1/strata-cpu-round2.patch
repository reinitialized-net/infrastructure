+// Same decoded lanes as IQ4_XS, with one wide shuffle instead of two narrow
+// shuffles and an insert. The integer products and floating reduction stay unchanged.
+template <> struct Fmt32<123> : Fmt32<23> {
+    static inline void decode(const uint8_t* b, int j, int half, __m256i& g, __m256i& sgn, __m256i& sc) {
+        const int H = 2 * j + half;
+        const __m256i values = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i*) kvalues_iq4nl));
+        const __m256i bits = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i*) (b + 8 + 16 * H)));
+        const __m256i indices = _mm256_and_si256(
+            _mm256_blend_epi32(bits, _mm256_srli_epi16(bits, 4), 0xf0), _mm256_set1_epi8(15));
+        const __m256i q4 = _mm256_shuffle_epi8(values, indices);
+        g = _mm256_sign_epi8(q4, q4);
+        sgn = _mm256_sign_epi8(_mm256_set1_epi8(1), q4);
+        const int ls = ((b[4 + (H >> 1)] >> (4 * (H & 1))) & 0xf) | (((u16(b + 2) >> (2 * H)) & 3) << 4);
+        sc = _mm256_set1_epi16((short) (ls - 32));
+    }
+};
