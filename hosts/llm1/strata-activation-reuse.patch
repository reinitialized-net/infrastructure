@@ -0,0 +1,59 @@
+// Compare activation reuse with the established IQ4_XS gate/up kernel, bit for bit.
+// Synthetic weights exercise every nibble and signed scale; no model or GPU required.
+#include "strata/kernels/cpu/expert_layout.hpp"
+#include "strata/kernels/cpu/iq_avx2.hpp"
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+int main() {
+    namespace cpu = strata::kernels::cpu;
+    if (!cpu::cpu_avx2_ok()) {
+        std::puts("iq4xs_gu1_parity: skipped (requires AVX2)");
+        return 77;
+    }
+    ggml_cpu_init();
+    constexpr int rows = 37;
+    const int spans[][2] = {{0, 0}, {0, 1}, {1, 3}, {3, 20}, {0, rows}, {rows - 1, rows}};
+    std::mt19937 rng(20261014);
+    std::uniform_real_distribution<float> values(-2.f, 2.f);
+    int cases = 0;
+    for (int n : {256, 768, 2560, 8192, 8448}) {
+        const size_t stride = ggml_row_size(GGML_TYPE_IQ4_XS, n);
+        const size_t up = stride * rows;
+        // Offset the blob to exercise unaligned expert storage, too.
+        std::vector<uint8_t> storage(up * 2 + 1), activation(ggml_row_size(GGML_TYPE_Q8_K, n));
+        auto* blob = storage.data() + 1;
+        std::vector<float> x(n), ref(rows), got(rows);
+        for (int seed = 0; seed < 8; ++seed) {
+            for (size_t i = 0; i < up * 2; ++i) blob[i] = (uint8_t) rng();
+            for (size_t i = 0; i < up * 2; i += ggml_type_size(GGML_TYPE_IQ4_XS)) {
+                const ggml_fp16_t scale = ggml_fp32_to_fp16(seed == 0 ? 0.f : values(rng) * .001f);
+                std::memcpy(blob + i, &scale, sizeof(scale));
+            }
+            for (auto& a : x) a = seed == 1 ? 0.f : values(rng);
+            ggml_get_type_traits_cpu(GGML_TYPE_Q8_K)->from_float(x.data(), activation.data(), n);
+            for (const auto& span : spans) {
+                std::fill(ref.begin(), ref.end(), -12345.f);
+                std::fill(got.begin(), got.end(), -12345.f);
+                cpu::iq4xs256_gu1_rows_v(false, blob, stride, up, n, activation.data(), ref.data(), span[0], span[1]);
+                cpu::iq4xs256_gu1_rows_v(true, blob, stride, up, n, activation.data(), got.data(), span[0], span[1]);
+                if (std::memcmp(ref.data(), got.data(), rows * sizeof(float))) {
+                    std::fprintf(stderr, "iq4xs_gu1_parity: mismatch n=%d seed=%d rows=[%d,%d)\n",
+                                 n, seed, span[0], span[1]);
+                    return 1;
+                }
+                for (int r = 0; r < rows; ++r)
+                    if ((r < span[0] || r >= span[1]) && got[r] != -12345.f) return 1;
+                ++cases;
+            }
+        }
+    }
+    std::printf("iq4xs_gu1_parity: %d cases, bitwise OK (including workspace fallback and untouched rows)\n", cases);
+}
