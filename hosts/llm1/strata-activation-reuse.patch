+}  // namespace
+
+void iq4xs256_gu1_rows_v(bool pack_act, const uint8_t* blob, size_t gu_row, size_t up_off, int n,
+                         const void* act, float* ff, int r0, int r1) {
+    if (pack_act && n > 0 && n <= 8192 && r1 - r0 > 1)
+        iq4xs_gu1<true>(blob, gu_row, up_off, n, act, ff, r0, r1);
