+void iq4xs256_gu1_rows(const uint8_t* blob, size_t gu_row, size_t up_off, int n, const void* act, float* ff,
+                       int r0, int r1) {
+    static const bool packed = [] { const char* v = std::getenv("STRATA_IQ4XS_PACK_ACT"); return v && v[0] == '1'; }();
