{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "indev"
  ],
  "dependencyDashboard": true,
  "enabledManagers": [
    "nix",
    "custom.regex"
  ],
  "nix": {
    "enabled": true
  },
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "separateMajorMinor": true,
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "labels": [
      "dependencies",
      "nix",
      "infra-auto-merge"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Docker image tags declared in host container definitions.",
      "managerFilePatterns": [
        "/^hosts/.*\\.nix$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\"\\s@:]+(?:/[^\"\\s@:]+)*):(?<currentValue>[^\"\\s@]+)\";"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the stable NixOS channel in flake.nix. Renovate 41's native nix manager detects this update but cannot replace the flake input ref before lockfile refresh.",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "nixpkgsStable\\.url\\s*=\\s*\"github:NixOS/nixpkgs/(?<currentValue>nixos-\\d{2}\\.\\d{2})\";"
      ],
      "depNameTemplate": "nixpkgsStable",
      "packageNameTemplate": "https://github.com/NixOS/nixpkgs",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "nixpkgs"
    }
  ],
  "packageRules": [
    {
      "description": "Group Nix flake input updates and make them eligible for local validation plus auto-merge.",
      "matchManagers": [
        "nix"
      ],
      "groupName": "nix flake inputs",
      "labels": [
        "dependencies",
        "nix",
        "infra-auto-merge"
      ],
      "automerge": false
    },
    {
      "description": "Disable native major stable-channel bumps because Renovate 41.169.3 re-extracts the old ref from flake.lock before it runs the Nix artifact update.",
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "nixpkgsStable"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Update the stable NixOS channel through the regex manager and refresh flake.lock with a constrained self-hosted post-upgrade command.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchDepNames": [
        "nixpkgsStable"
      ],
      "groupName": "nix flake inputs",
      "labels": [
        "dependencies",
        "nix",
        "infra-auto-merge"
      ],
      "postUpgradeTasks": {
        "commands": [
          "nix flake update {{{depName}}}"
        ],
        "fileFilters": [
          "flake.lock"
        ]
      },
      "automerge": false
    },
    {
      "description": "Detect Docker image tag updates and apply base container labels.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "labels": [
        "dependencies",
        "container"
      ],
      "automerge": false
    },
    {
      "description": "Keep UniFi MongoDB on a version supported by the LinuxServer UniFi Network Application image.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/library/mongo"
      ],
      "allowedVersions": "<8.0",
      "labels": [
        "dependencies",
        "container",
        "service:unifi",
        "stateful-data",
        "manual-update"
      ],
      "automerge": false
    },
    {
      "description": "Review datastore image updates separately because they own persistent service data.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "pgvector/pgvector",
        "valkey/valkey"
      ],
      "labels": [
        "dependencies",
        "container",
        "stateful-data",
        "manual-update"
      ],
      "automerge": false
    },
    {
      "description": "Keep redundant Technitium DNS nodes together without grouping them with unrelated services.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "technitium/dns-server"
      ],
      "groupName": "technitium dns server image",
      "labels": [
        "dependencies",
        "container",
        "service:dns"
      ],
      "automerge": false
    },
    {
      "description": "Keep Authentik server and worker updates together.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/goauthentik/server"
      ],
      "groupName": "authentik server image",
      "labels": [
        "dependencies",
        "container",
        "service:authentik"
      ],
      "automerge": false
    },
    {
      "description": "Keep Hudu web and worker updates together.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "hududocker/hudu"
      ],
      "groupName": "hudu image",
      "labels": [
        "dependencies",
        "container",
        "service:hudu"
      ],
      "automerge": false
    },
    {
      "description": "Keep paired Immich images together.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "immich images",
      "labels": [
        "dependencies",
        "container",
        "service:immich",
        "manual-update"
      ],
      "automerge": false
    },
    {
      "description": "Review Forgejo server updates separately from runners and other containers.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "code.forgejo.org/forgejo/forgejo"
      ],
      "groupName": "forgejo server image",
      "labels": [
        "dependencies",
        "container",
        "service:forgejo"
      ],
      "automerge": false
    },
    {
      "description": "Review Forgejo runner updates separately from the Forgejo server.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "code.forgejo.org/forgejo/runner"
      ],
      "groupName": "forgejo runner image",
      "labels": [
        "dependencies",
        "container",
        "service:forgejo-runner"
      ],
      "automerge": false
    },
    {
      "description": "Allow local promoter automation for non-major and digest-level container updates.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "minor",
        "patch"
      ],
      "labels": [
        "dependencies",
        "container",
        "infra-auto-merge"
      ],
      "automerge": false
    },
    {
      "description": "Keep major container updates open for manual review.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "container",
        "manual-update"
      ],
      "automerge": false
    }
  ]
}
