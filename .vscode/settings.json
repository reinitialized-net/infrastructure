{
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nixd",
    "nix.serverSettings": {
        "nixd": {
            "formatting": {
                "command": ["nixfmt"],
            },
            "options": {
                "nixos": {
                    "expr": "(builtins.getFlake \"/home/develop/projects/reinitialized.net/flake.nix\").nixosConfigurations"
                },
            }
        }
    },
    "nixEnvSelector.nixFile": "${workspaceFolder}/flake.nix"
}